# Papex server base URL (no trailing slash). VITE_-prefixed vars are exposed
# to the client bundle by Vite.
VITE_API_BASE_URL=https://api.papex.example.com

# Fallback UI language: "zh" or "en"
VITE_I18N_FALLBACK=zh

# Local PDF cache limit (MB). Older cached PDFs are evicted beyond this.
VITE_CACHE_LIMIT_MB=2048

# Optional API key used to bootstrap the demo before backend auth endpoints ship.
# TODO(backend): remove once /api/auth/login (App mode) is available.
VITE_PAPEX_API_KEY=
